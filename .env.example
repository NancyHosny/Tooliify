# Copy this file to ".env" and put the real values there.
# ".env" is ignored by git – never commit real credentials.

# Dashboard website address (no trailing slash)
BASE_URL=https://stg.tooliify.com

# Path of the login page (Arabic UI)
LOGIN_PATH=/ar/auth

# Path of the profile page – copy it from the browser address bar
PROFILE_PATH=/ar/profile

# Backend API address – leave empty until confirmed (API tests are skipped when empty)
API_URL=

# Active merchant test account (SRS 10.2)
MERCHANT_EMAIL=merchant@example.com
MERCHANT_PASSWORD=change-me

# Optional accounts for blocked scenarios (tests are skipped while empty)
FIRST_LOGIN_EMAIL=
FIRST_LOGIN_PASSWORD=
EXPIRED_EMAIL=
EXPIRED_PASSWORD=
SUSPENDED_EMAIL=
SUSPENDED_PASSWORD=
